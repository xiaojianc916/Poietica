  "dependencies": {
    "@poietica/editor-core": "workspace:*",
    "@poietica/editor-persistence": "workspace:*"
  },
  "devDependencies": {
    "tldraw": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "tldraw": "5.2.5"
  }
}
