{
  "name": "@poietica/editor-document",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/public-api.ts",
      "default": "./src/public-api.ts"
    }
  },
  "scripts": {
    "check": "tsc --project tsconfig.json --noEmit",
