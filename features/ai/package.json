{
  "name": "@poietica/features-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./contracts": {
      "types": "./src/contracts/public-api.ts",
      "default": "./src/contracts/public-api.ts"
    },
    "./application": {
      "types": "./src/application/public-api.ts",
      "default": "./src/application/public-api.ts"
    },
    "./adapters": {
      "types": "./src/adapters/public-api.ts",
      "default": "./src/adapters/public-api.ts"
    },
    "./react": {
      "types": "./src/presentation/public-api.ts",
      "default": "./src/presentation/public-api.ts"
    }
  },
  "scripts": {
    "check": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mynaui/icons-react": "catalog:",
    "@poietica/foundations-design-system": "workspace:*",
    "@streamdown/cjk": "catalog:",
    "@streamdown/code": "catalog:",
    "@streamdown/math": "catalog:",
    "@streamdown/mermaid": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "motion": "catalog:",
    "streamdown": "catalog:",
    "tailwind-merge": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
