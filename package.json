{
  "name": "poietica",
  "version": "0.1.3",
  "private": true,
  "description": "Poietica — a local-first AI agent desktop environment for thinking, describing, and creating.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaojianc916/poietica.git"
  },
  "bugs": {
    "url": "https://github.com/xiaojianc916/poietica/issues"
  },
  "homepage": "https://github.com/xiaojianc916/poietica#readme",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=26.2.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "audit:rust": "cargo deny check --all-features",
    "build:debug": "pnpm --filter @poietica/desktop exec tauri build --target x86_64-pc-windows-msvc --debug --no-bundle",
    "build:release": "pnpm --filter @poietica/desktop exec tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.release.conf.json",
    "build:web": "turbo run build",
    "check": "pnpm check:web && pnpm check:rust",
    "check:rust": "cargo fmt --check && pnpm clippy && pnpm test:rust",
    "check:versions": "node scripts/release/check-versions.mjs",
    "check:web": "biome ci . && node tests/architecture/run.mjs && turbo run typecheck test --continue",
    "clean": "node scripts/clean.mjs",
    "clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "dev": "turbo run dev --filter=@poietica/desktop",
    "format": "biome format --write .",
    "ipc:check": "pnpm ipc:generate && git diff --exit-code -- packages/ipc/src/generated/ipc-bindings.ts",
    "ipc:generate": "cargo run -p poietica --bin export-ipc-bindings",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "perf": "pnpm --filter @poietica/agent-timeline run bench",
    "perf:churn": "pnpm --filter @poietica/agent-timeline run churn",
    "perf:native": "cargo run --release -p poietica-agent-runtime-native --example frame_throughput",
    "perf:profile": "node scripts/perf/profile.mjs",
    "perf:render": "node scripts/perf/render.mjs",
    "prepare": "node scripts/git-hooks/install.mjs",
    "release": "node release.mjs",
    "tauri": "node scripts/tauri.mjs",
    "test": "turbo run test --continue",
    "test:architecture": "node tests/architecture/run.mjs",
    "test:rust": "cargo test --workspace --all-features",
    "typecheck": "turbo run typecheck --continue",
    "verify:channel": "node scripts/release/verify-channel.mjs",
    "verify:release": "pnpm check:versions && pnpm check && pnpm ipc:check && pnpm audit && pnpm audit:rust && pnpm build:release",
    "version:set": "node scripts/release/set-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
