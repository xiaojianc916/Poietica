{
  "name": "poietica",
  "version": "0.1.0",
  "private": true,
  "description": "Poietica — a local-first, AI-assisted canvas for thinking, describing, and creating.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaojianc916/poietica.git"
  },
  "bugs": {
    "url": "https://github.com/xiaojianc916/poietica/issues"
  },
  "homepage": "https://github.com/xiaojianc916/poietica#readme",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=26.2.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "dev": "turbo run dev --filter=@poietica/desktop",
    "build": "pnpm --filter @poietica/desktop exec tauri build",
    "build:debug": "pnpm --filter @poietica/desktop exec tauri build --debug --no-bundle",
    "build:web": "turbo run build",
    "check": "pnpm check:web && pnpm check:rust",
    "check:web": "biome ci . && node tests/architecture/run.mjs && turbo run typecheck test --continue",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace --all-features",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test --continue",
    "test:architecture": "node tests/architecture/run.mjs",
    "test:rust": "cargo test --workspace --all-features",
    "audit": "pnpm audit --audit-level high",
    "audit:rust": "cargo deny check --all-features",
    "ipc:generate": "cargo run -p poietica --bin export-ipc-bindings",
    "ipc:check": "pnpm ipc:generate && git diff --exit-code -- platforms/desktop-ipc/src/generated/ipc-bindings.ts",
    "check:versions": "node scripts/release/check-versions.mjs",
    "verify:release": "pnpm check:versions && pnpm check && pnpm ipc:check && pnpm audit && pnpm audit:rust && pnpm build",
    "tauri": "pnpm --filter @poietica/desktop exec tauri",
    "clean": "node scripts/clean.mjs",
    "prepare": "node scripts/git-hooks/install.mjs",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "catalog:",
    "@typescript/typescript6": "6.0.2",
    "turbo": "2.10.7",
    "typescript": "catalog:"
  }
}
