{
  "name": "@poietica/desktop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@poietica/editor-core": "workspace:*",
    "@poietica/features-ai": "workspace:*",
    "@poietica/foundations-design-system": "workspace:*",
    "@poietica/editor-document": "workspace:*",
    "@poietica/foundations-kernel": "workspace:*",
    "@poietica/foundations-observability": "workspace:*",
    "@poietica/platforms-desktop-ipc": "workspace:*",
    "@poietica/platforms-desktop-runtime": "workspace:*",
    "@poietica/features-settings": "workspace:*",
    "@poietica/features-workspace": "workspace:*",
    "@mynaui/icons-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tldraw": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:tauri",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
